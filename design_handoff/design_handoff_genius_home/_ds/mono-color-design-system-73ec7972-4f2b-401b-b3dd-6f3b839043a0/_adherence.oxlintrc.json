{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/information/**",
              "components/marks/**",
              "components/plate/**",
              "components/poster/**",
              "components/type/**",
              "ui_kits/printed-artifacts/**",
              "ui_kits/reference-board/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Archivo Narrow|Jost|Libre Bodoni|Courier Prime|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Archivo Narrow, Jost, Libre Bodoni, Courier Prime, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarrierBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|id|ratios|key|ref|className|style|children)$/]",
        "message": "<CarrierBadge> doesn't accept that prop. Declared props: name, id, ratios."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompositionThumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|width|key|ref|className|style|children)$/]",
        "message": "<CompositionThumb> doesn't accept that prop. Declared props: layout, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompositionThumb'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:composition_image_field|composition_specimen_annotation|composition_type_declaration|composition_ruled_information|composition_archival_plate|composition_editorial_cover|composition_object_field|composition_overprint_collage|composition_editorial_journal)$/]",
        "message": "<CompositionThumb> layout must be one of 'composition_image_field' | 'composition_specimen_annotation' | 'composition_type_declaration' | 'composition_ruled_information' | 'composition_archival_plate' | 'composition_editorial_cover' | 'composition_object_field' | 'composition_overprint_collage' | 'composition_editorial_journal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:voice|size|ink|rotated|as|children|key|ref|className|style|children)$/]",
        "message": "<DisplayHeading> doesn't accept that prop. Declared props: voice, size, ink, rotated, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute[name.name='voice'] > Literal[value!=/^(?:literary|cultural|condensed|programmatic|typographic)$/]",
        "message": "<DisplayHeading> voice must be one of 'literary' | 'cultural' | 'condensed' | 'programmatic' | 'typographic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HalftoneField'] > JSXAttribute > JSXIdentifier[name!=/^(?:ink|paper|cell|coverage|children|key|ref|className|style|children)$/]",
        "message": "<HalftoneField> doesn't accept that prop. Declared props: ink, paper, cell, coverage, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkPair'] > JSXAttribute > JSXIdentifier[name!=/^(?:dominant|accent|mode|size|key|ref|className|style|children)$/]",
        "message": "<InkPair> doesn't accept that prop. Declared props: dominant, accent, mode, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkPair'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|l)$/]",
        "message": "<InkPair> size must be one of 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkSwatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|id|hex|size|showMeta|key|ref|className|style|children)$/]",
        "message": "<InkSwatch> doesn't accept that prop. Declared props: name, id, hex, size, showMeta."
      },
      {
        "selector": "JSXOpeningElement[name.name='InkSwatch'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m|l)$/]",
        "message": "<InkSwatch> size must be one of 's' | 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|weight|tracking|uppercase|as|children|key|ref|className|style|children)$/]",
        "message": "<MicroLabel> doesn't accept that prop. Declared props: tone, size, weight, tracking, uppercase, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:substrate|noise|children|key|ref|className|style|children)$/]",
        "message": "<PaperSheet> doesn't accept that prop. Declared props: substrate, noise, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperSheet'] > JSXAttribute[name.name='substrate'] > Literal[value!=/^(?:neutral-white|cool-gray|pale-beige)$/]",
        "message": "<PaperSheet> substrate must be one of 'neutral-white' | 'cool-gray' | 'pale-beige'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlateBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|key|ref|className|style|children)$/]",
        "message": "<PlateBadge> doesn't accept that prop. Declared props: tone, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlateBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:index|mark|ink)$/]",
        "message": "<PlateBadge> tone must be one of 'index' | 'mark' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:ratio|substrate|width|margin|edge|children|key|ref|className|style|children)$/]",
        "message": "<PosterSheet> doesn't accept that prop. Declared props: ratio, substrate, width, margin, edge, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterSheet'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:3:4|2:3|4:5|1:1|4:3)$/]",
        "message": "<PosterSheet> ratio must be one of '3:4' | '2:3' | '4:5' | '1:1' | '4:3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterSheet'] > JSXAttribute[name.name='substrate'] > Literal[value!=/^(?:neutral-white|cool-gray|pale-beige)$/]",
        "message": "<PosterSheet> substrate must be one of 'neutral-white' | 'cool-gray' | 'pale-beige'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RegistrationMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|ink|weight|key|ref|className|style|children)$/]",
        "message": "<RegistrationMark> doesn't accept that prop. Declared props: size, ink, weight."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuledDataStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|rule|weight|ink|size|align|key|ref|className|style|children)$/]",
        "message": "<RuledDataStrip> doesn't accept that prop. Declared props: items, rule, weight, ink, size, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuledDataStrip'] > JSXAttribute[name.name='rule'] > Literal[value!=/^(?:above|below|both)$/]",
        "message": "<RuledDataStrip> rule must be one of 'above' | 'below' | 'both'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuledDataStrip'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:between|start)$/]",
        "message": "<RuledDataStrip> align must be one of 'between' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|subtitle|weight|key|ref|className|style|children)$/]",
        "message": "<SectionRule> doesn't accept that prop. Declared props: number, title, subtitle, weight."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecimenCaption'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|id|rows|note|key|ref|className|style|children)$/]",
        "message": "<SpecimenCaption> doesn't accept that prop. Declared props: name, id, rows, note."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
