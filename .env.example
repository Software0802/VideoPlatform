# 官方 xAI（优先）。按秒计费。
# XAI_API_KEY=xai-...
# XAI_BASE_URL=https://api.x.ai/v1

# Sub2API 反代（拼车）。仅在未设置 XAI_API_KEY 时使用。
# SUB2API_API_KEY=sk-...
# 不填 XAI_BASE_URL 时默认 http://127.0.0.1:8080/v1

# OpenAI 官方生图。**只影响文生图（text_to_image）**，视频与其他模式一律不读这几项。
# 设置 OPENAI_API_KEY 后文生图走 https://api.openai.com/v1/images/generations（gpt-image-1）；
# 不设置则文生图仍按 XAI_API_KEY / SUB2API_API_KEY 走 xAI，两把 key 都没有才回落 mock。
# 画幅芯片在 OpenAI 侧映射为官方三档尺寸 + 本地居中裁切；1k/2k 芯片映射为 low/high 画质档。
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1
# 注意：gpt-image-1 出图常需 30–120 秒，超过 UPSTREAM_TIMEOUT_MS 会被中止并自动重试，
# 而图片可能已计费。启用 OpenAI 生图时把 UPSTREAM_TIMEOUT_MS 调到 180000 以上。

# 强制走 mock（有 key 也出 ffmpeg 水印片，便于 UI）
# LUMEN_FORCE_MOCK=1

# 最小鉴权。设置后全部 /api/* 需要 Authorization: Bearer 或 Cookie lumen_token
# 未设置时视为本地单用户，不要把端口暴露到公网。
# LUMEN_ACCESS_TOKEN=

# 数据目录（默认 ./data）
# DATA_DIR=

JOB_CONCURRENCY=2
MAX_QUEUED_JOBS=20
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_RETRY_BASE_MS=250

# 一致性管线（30 / 45 / 60 秒长片）。M2.4 起生效：开启后 UI 多出长片时长，
# 任务走 Director → Keyframe → Shots(+QC) → Stitch。mock 模式可放心开启；真实 key 下
# 单片成本 ≈ $2.1–4.2，超过预估 ×2 自动停止重试。
HARNESS_ENABLED=false
# 每个长片任务并行生成的 shot 数（1–4）
# HARNESS_SHOT_CONCURRENCY=2
# grok-4.6 视觉一致性 QC 阈值（0–1）。不设即跳过视觉打分——阈值需用 evals/runs 对照集校准后再固定。
# HARNESS_QC_VISUAL_THRESHOLD=0.6
WORKFLOWS_ENABLED=false
JIMENG_ENABLED=false

# OpenAI 生图请求超时（毫秒）。gpt-image-1 常需 30-120 秒；这条路径不重试，
# 超时即失败，由用户决定是否重新提交（每次被接受的请求都计费）。
# OPENAI_IMAGE_TIMEOUT_MS=180000
